# Django Configuration
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=*

# Database Configuration (Render sets this automatically if using Render PostgreSQL)
# Example PostgreSQL: postgres://username:password@hostname:5432/dbname
DATABASE_URL=

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
# Or specify allowed origins separated by commas:
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# CSRF Configuration
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com
